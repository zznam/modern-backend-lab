{
  "name": "modern-backend-lab",
  "version": "1.0.0",
  "description": "Modern Backend Engineering Mastery Lab - Comprehensive Hands-on Interactive Learning Platform",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "lab": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench:load": "tsx src/04-devops-reliability/load-testing/runner.ts",
    "bench:go": "go run src/companion-go/concurrency_bench.go",
    "troubleshoot": "bash src/scripts/live-troubleshoot.sh",
    "check": "npm run typecheck && npm test && npm run build",
    "start:prod": "node dist/server.js"
  },
  "keywords": [
    "backend",
    "system-design",
    "distributed-systems",
    "architecture",
    "concurrency",
    "reliability",
    "observability"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "hyperid": {
      "uuid": "^11.1.1"
    }
  }
}
